# Research data -- not tracked (see README > Data)
spruce/data/*
!spruce/data/.gitkeep
spruce/output/*
!spruce/output/.gitkeep
qtlmas/data/*
qtlmas/output/*
!qtlmas/data/.gitkeep
!qtlmas/output/.gitkeep

# Common data/result file types, wherever they land
*.jld2
*.csv
*.txt
!README*.txt

# ...except the small, synthetic quickstart example -- it's meant to be
# committed so the pipeline is runnable straight out of the clone.
!example/data/*.txt
!example/data/*.csv

# Manuscript build artifacts (keep sources, drop generated output)
manuscript/*.aux
manuscript/*.log
manuscript/*.out
manuscript/*.bbl
manuscript/*.blg
manuscript/*.synctex.gz

# Julia
Manifest.toml
*.jl.cov
*.jl.*.cov
*.jl.mem

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
